{
  "name": "md-highlighter",
  "displayName": "Markdown Highlighter",
  "description": "A Markdown reader for docs your AI agents write: highlight while you read, see what changed since you last read, checklist progress, search, and highlights agents can read and write.",
  "version": "0.2.0",
  "publisher": "jmacy",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "bin": {
    "mdhl": "./bin/mdhl.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "mdHighlighter.open",
        "title": "Open with Highlighter",
        "category": "Markdown Highlighter",
        "icon": "$(symbol-color)"
      },
      {
        "command": "mdHighlighter.refresh",
        "title": "Refresh",
        "category": "Markdown Highlighter",
        "icon": "$(refresh)"
      },
      {
        "command": "mdHighlighter.toggleResolved",
        "title": "Show/Hide Resolved",
        "category": "Markdown Highlighter",
        "icon": "$(filter)"
      },
      {
        "command": "mdHighlighter.reveal",
        "title": "Go to Highlight",
        "category": "Markdown Highlighter"
      },
      {
        "command": "mdHighlighter.search",
        "title": "Search Highlights",
        "category": "Markdown Highlighter",
        "icon": "$(search)"
      },
      {
        "command": "mdHighlighter.export",
        "title": "Export Highlights…",
        "category": "Markdown Highlighter",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdHighlighter.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdHighlighter.open",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mdHighlighter.open",
          "when": "resourceLangId == markdown"
        }
      ],
      "view/title": [
        {
          "command": "mdHighlighter.search",
          "when": "view == mdHighlighter.tree",
          "group": "navigation"
        },
        {
          "command": "mdHighlighter.toggleResolved",
          "when": "view == mdHighlighter.tree",
          "group": "navigation"
        },
        {
          "command": "mdHighlighter.refresh",
          "when": "view == mdHighlighter.tree",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdHighlighter.reveal",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "mdHighlighter.tree",
          "name": "Highlights"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Highlighter",
      "properties": {
        "mdHighlighter.author": {
          "type": "string",
          "default": "You",
          "description": "Name recorded on highlights you create in the editor."
        }
      }
    },
    "keybindings": [
      {
        "command": "mdHighlighter.search",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ]
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  },
  "scripts": {
    "package": "vsce package"
  },
  "keywords": [
    "markdown",
    "reader",
    "highlight",
    "annotation",
    "ai agents",
    "notes"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Heavens-Lava/md-highlighter.git"
  },
  "homepage": "https://github.com/Heavens-Lava/md-highlighter#readme",
  "bugs": {
    "url": "https://github.com/Heavens-Lava/md-highlighter/issues"
  }
}
